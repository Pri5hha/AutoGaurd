NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/autogaurd

# Generate strong values with: node server/scripts/generate-secrets.js
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

LOG_GET_REQUESTS=false
ML_SERVICE_URL=http://127.0.0.1:5001
CLIENT_URL=http://localhost:5173
# Optional: comma-separated list of allowed origins (overrides CLIENT_URL)
# CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173

# Reserved, not used by the code yet
GEMINI_API_KEY=

# Email alerts (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=no-reply@autoguard.local

# SMS alerts (optional)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Reserved for on-chain anchoring, not used by the code yet
ETH_RPC_URL=
ETH_PRIVATE_KEY=
ETH_CONTRACT_ADDRESS=
